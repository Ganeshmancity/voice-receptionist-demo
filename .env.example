# Postgres (Supabase: use the "Transaction pooler" connection string, port 6543)
DATABASE_URL=

# Shared secret Vapi sends in the x-demo-secret header on every webhook. Any long random string.
VAPI_WEBHOOK_SECRET=

# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/reset for the daily demo reset.
CRON_SECRET=

# Browser-side: Vapi PUBLIC key (restrict it to your domain + this assistant in the Vapi dashboard)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Only needed locally to run scripts/create-assistant.ts. Never put it in Vercel or the browser.
# VAPI_PRIVATE_KEY=
# APP_URL=https://your-app.vercel.app
